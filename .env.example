# Токен бота из @BotFather
TELEGRAM_TOKEN=123456789:AAExampleTokenFromBotFather

# Ключ TokenHarbor (https://tokenharbor.ai/dashboard)
TOKENHARBOR_API_KEY=thk_live_example

# Модель. Бесплатные: deepseek-v4.1-flash:free, deepseek-v4-flash:free,
# mimo-v2.5:free, mimo-v2.6-flash:free. Платные требуют баланс > $0.
# MODEL=deepseek-v4.1-flash:free

# Твой Telegram ID: бот будет отвечать только тебе.
# Узнать: запусти бота и отправь ему /id (или напиши @userinfobot).
TELEGRAM_OWNER_ID=123456789

# Голосовые сообщения: бесплатный ключ Groq (https://console.groq.com/keys).
# Без него бот работает, но голосовые не распознаёт.
# GROQ_API_KEY=
# STT_MODEL=whisper-large-v3-turbo

# Необязательно: другой OpenAI-совместимый STT
# STT_URL=https://api.groq.com/openai/v1/audio/transcriptions
